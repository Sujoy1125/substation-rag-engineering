# Copy to .env and fill in. .env is gitignored.
#
# LEAVE OPTIONAL KEYS COMMENTED OUT, not blank.
# A blank value is not the same as an unset one. Libraries that read an
# environment variable directly — the OpenAI SDK reads OPENAI_BASE_URL — treat
# "" as "configured, to nothing" and build a request to a URL with no scheme.
# The result is a bare "Connection error" that looks exactly like a firewall.
# (load_dotenv() now skips empty values too, so both halves are protected.)

# --- Generation layer -------------------------------------------------------
# Which provider src.generation.llm.client_from_env() builds. openai | anthropic
LLM_PROVIDER=openai

# OpenAI (default provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: point at an OpenAI-compatible endpoint.
# Uncomment ONLY if you mean it. Leaving it blank is what broke the first live run.
#
# The client speaks plain OpenAI protocol, so any compatible endpoint works with
# no code change — set the three values together (key, base URL, model) and keep
# LLM_PROVIDER=openai. Whichever you pick, DO NOT change it between the
# calibration run and the holdout run: the confidence weights are fitted per
# model, and swapping models invalidates them.
#
#   Azure OpenAI     OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
#                    OPENAI_MODEL=<your DEPLOYMENT name, not the model family name>
#                    (the trailing slash matters)
#   Google Gemini    OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                    OPENAI_MODEL=gemini-2.5-flash
#   Groq             OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter       OPENAI_BASE_URL=https://openrouter.ai/api/v1
#                    OPENAI_MODEL=nvidia/nemotron-3.5-lightning:free
#                    NOTE: ":free" models are capped at 20 req/min and 50 req/DAY
#                    until $10 of credit has been purchased (lifetime, not
#                    balance), after which the daily cap is 1000. A full graded
#                    evaluation is ~114 requests, so 50/day cannot complete one.
#
# Free and student tiers rate-limit with HTTP 429. That is handled: the client
# tells a rate-limit 429 apart from an out-of-credit 429 and retries the former
# with backoff. See src/generation/llm.py:classify_api_error.
# OPENAI_BASE_URL=https://your-endpoint/v1

# Anthropic (only needed if LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Not required yet -------------------------------------------------------
# PostgreSQL/pgvector is NOT required for the current pipeline — retrieval is
# in-process BM25 over the frozen KB. Provision only when the API phase needs it.
# DATABASE_URL=postgresql://user:password@localhost:5432/substation_rag

# Embedding provider — dense/hybrid retrieval remains UNMEASURED, see docs/BLOCKERS.md
# EMBEDDING_PROVIDER=
# EMBEDDING_API_KEY=
